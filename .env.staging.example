# Copy to .env.staging; chmod 600; never commit. Docker Compose uses these for interpolation.
# Keep ordinary .env in place for base Compose env_file substitute and local settings.
DEPLOYMENT_MODE=staging
TRUSTED_TLS_PROXY=true
STAGING_HOST=staging.example.org
ACME_EMAIL=operator@example.org
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_48_PLUS_CHAR_SECRET
MARKETS=spot,futures
SYMBOLS=BTCUSDT,ETHUSDT
ENABLE_LIVE_TRADING=false
ENABLE_TESTNET_EXECUTION=false
TESTNET_CONFIRM=NOT_CONFIRMED
ROLE_PASSWORD_GATEWAY=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_COLLECTOR=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_OUTBOX=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_PAPER=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_RESEARCH=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_EXCHANGE=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
ROLE_PASSWORD_OPERATIONS=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
