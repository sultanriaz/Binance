# Copy this file to .env. Do not commit .env.
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://trader:local_dev_only@postgres:5432/trader
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
MARKETS=spot,futures
SYMBOLS=BTCUSDT,ETHUSDT
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
BINANCE_SPOT_REST=https://api.binance.com
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_SPOT_WSS=wss://stream.binance.com:9443
BINANCE_FUTURES_WSS=wss://fstream.binance.com/market
# Local development default. Keep all live trading disabled here.
ENABLE_LIVE_TRADING=false

# P15-P19: Separate exchange *test* execution. NEVER enter live credentials.
# Disabled by default: BOTH flags must be deliberately set and operator must arm the account in UI.
ENABLE_TESTNET_EXECUTION=false
TESTNET_CONFIRM=NOT_CONFIRMED
TESTNET_SYMBOLS=BTCUSDT,ETHUSDT
TESTNET_MAX_ORDER_USDT=50
TESTNET_MAX_DAILY_ORDERS=20
TESTNET_MAX_LEVERAGE=2
EXCHANGE_POLL_SECONDS=5

# Module 5: local defaults; staging sets dedicated role credentials in .env.staging
DEPLOYMENT_MODE=development
TRUSTED_TLS_PROXY=false
